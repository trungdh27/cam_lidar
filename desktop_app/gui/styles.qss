
QWidget {
    font-family: "DejaVu Sans";
    font-size: 13px;
    color: #263238;
}

QMainWindow, QWidget#Root {
    background: #f4f6f8;
}

QWidget#TopBar {
    background: #ffffff;
    border-bottom: 1px solid #dfe5e8;
}

QLabel#BrandTitle {
    font-size: 18px;
    font-weight: 700;
    color: #1f2d33;
}

QLabel#BrandSubtitle {
    font-size: 11px;
    color: #78909c;
}

QLabel#JetsonPill {
    padding: 7px 13px;
    border-radius: 14px;
    background: #e7f6f3;
    color: #168b91;
    font-weight: 700;
}

QWidget#Sidebar {
    background: #eef1f3;
    border-right: 1px solid #dfe5e8;
}

QPushButton#NavButton {
    text-align: left;
    padding: 11px 14px;
    border: none;
    border-radius: 7px;
    color: #455a64;
    background: transparent;
}

QPushButton#NavButton:hover {
    background: #e2e8ea;
}

QPushButton#NavButton:checked {
    background: #d9eeee;
    color: #168b91;
    font-weight: 700;
}

QLabel#PageTitle {
    font-size: 22px;
    font-weight: 700;
    color: #263238;
}

QLabel#PageSubtitle {
    color: #78909c;
    font-size: 12px;
}

QFrame#Card {
    background: #ffffff;
    border: 1px solid #e0e6e9;
    border-radius: 10px;
}

QLabel#CardTitle {
    font-size: 12px;
    font-weight: 700;
    color: #607d8b;
}

QLabel#CardValue {
    font-size: 18px;
    font-weight: 700;
    color: #263238;
}

QLabel#StatusConnected {
    color: #2e9d68;
    font-weight: 700;
}

QLabel#StatusDisconnected {
    color: #d9534f;
    font-weight: 700;
}

QPushButton#PrimaryButton {
    background: #168b91;
    color: white;
    border: none;
    border-radius: 7px;
    padding: 9px 16px;
    font-weight: 700;
}

QPushButton#PrimaryButton:hover {
    background: #11777c;
}

QPushButton#SecondaryButton {
    background: #ffffff;
    color: #455a64;
    border: 1px solid #cfd8dc;
    border-radius: 7px;
    padding: 9px 16px;
    font-weight: 600;
}

QPushButton#DangerButton {
    background: #ffffff;
    color: #c44;
    border: 1px solid #e4b9b9;
    border-radius: 7px;
    padding: 9px 16px;
    font-weight: 600;
}

QLineEdit, QSpinBox, QComboBox {
    background: white;
    border: 1px solid #cfd8dc;
    border-radius: 6px;
    padding: 7px 9px;
    min-height: 22px;
}

QPlainTextEdit#Terminal {
    background: #162126;
    color: #d9e5e8;
    border: 1px solid #263238;
    border-radius: 8px;
    padding: 8px;
    font-family: "DejaVu Sans Mono";
    font-size: 12px;
}

QTableWidget {
    background: #ffffff;
    border: 1px solid #e0e6e9;
    border-radius: 8px;
    gridline-color: #edf1f3;
    selection-background-color: #d9eeee;
    selection-color: #263238;
}

QHeaderView::section {
    background: #f6f8f9;
    border: none;
    border-bottom: 1px solid #dfe5e8;
    padding: 8px;
    font-weight: 700;
    color: #546e7a;
}

QCheckBox {
    spacing: 7px;
}

QProgressBar {
    border: 1px solid #dfe5e8;
    border-radius: 5px;
    background: #f4f6f8;
    text-align: center;
}

QProgressBar::chunk {
    background: #168b91;
    border-radius: 4px;
}
